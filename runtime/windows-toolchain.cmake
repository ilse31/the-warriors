set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(WARRIORS_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(WARRIORS_SDK "${WARRIORS_ROOT}/build/xwin-cpp/xwin")
if(NOT EXISTS "${WARRIORS_SDK}/crt/include/string")
    message(FATAL_ERROR "Populate the Windows SDK with cargo xwin before configuring this build")
endif()
execute_process(COMMAND xcrun --find clang OUTPUT_VARIABLE WARRIORS_CLANG OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${WARRIORS_ROOT}/build/cross-tools")
if(NOT EXISTS "${WARRIORS_ROOT}/build/cross-tools/clang-cl")
    file(CREATE_LINK "${WARRIORS_CLANG}" "${WARRIORS_ROOT}/build/cross-tools/clang-cl" SYMBOLIC)
endif()
set(CMAKE_C_COMPILER "${WARRIORS_ROOT}/build/cross-tools/clang-cl")
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "${WARRIORS_ROOT}/build/xwin/lld-link")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/windows-lib")
set(CMAKE_RC_COMPILER "${CMAKE_CURRENT_LIST_DIR}/windows-rc")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(CMAKE_C_FLAGS_INIT "/imsvc\"${WARRIORS_SDK}/crt/include\" /imsvc\"${WARRIORS_SDK}/sdk/include/ucrt\" /imsvc\"${WARRIORS_SDK}/sdk/include/um\" /imsvc\"${WARRIORS_SDK}/sdk/include/shared\" /imsvc\"${WARRIORS_SDK}/sdk/include/winrt\"")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/manifest:no /libpath:\"${WARRIORS_SDK}/crt/lib/x86_64\" /libpath:\"${WARRIORS_SDK}/sdk/lib/um/x86_64\" /libpath:\"${WARRIORS_SDK}/sdk/lib/ucrt/x86_64\"")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
